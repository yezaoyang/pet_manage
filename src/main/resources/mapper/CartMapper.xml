<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.modules.cartManage.dao.CartMapper">

    <resultMap id="CartResultMap" type="org.example.modules.cartManage.entity.Cart">
        <id column="id" property="id"/>
        <result column="customer_id" property="customerId"/>
        <result column="good_id" property="goodId"/>
        <result column="quantity" property="quantity"/>
        <result column="goodName" property="goodName"/>
        <result column="price" property="price"/>
        <result column="image_url" property="imageUrl"/>

    </resultMap>

    <insert id="insertCart" parameterType="org.example.modules.cartManage.entity.Cart">
        INSERT INTO cart (customer_id, good_id, quantity)
        VALUES (#{customerId}, #{goodId}, #{quantity})
    </insert>

    <select id="selectCartByCustomerIdAndGoodsId" resultMap="CartResultMap">
        SELECT id, customer_id, good_id, quantity
        FROM cart
        WHERE customer_id = #{customerId} AND good_id = #{goodId}
    </select>

    <update id="updateQuantityById">
        UPDATE cart
        SET quantity = #{quantity}
        WHERE id = #{id}
    </update>

    <select id="selectCartListByUserId" resultMap="CartResultMap">
        SELECT
            c.id,
            c.customer_id,
            c.good_id,
            c.quantity,
            g.name AS goodName,
            g.price AS price,
            g.image_url As imageUrl
        FROM cart c
                 LEFT JOIN good g ON c.good_id = g.id
        WHERE c.customer_id = #{customerId}
    </select>

    <delete id="deleteCartById">
        DELETE FROM cart WHERE id = #{id}
    </delete>

    <delete id="deleteCartByUserId">
        DELETE FROM cart WHERE customer_id = #{customerId}
    </delete>

</mapper>