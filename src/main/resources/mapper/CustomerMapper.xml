<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.modules.customerManage.dao.CustomerMapper">

    <select id="selectByUsername" resultType="org.example.modules.customerManage.entity.Customer">
        SELECT id, name, password FROM customer WHERE name = #{name}
    </select>

    <insert id="insert" parameterType="org.example.modules.customerManage.entity.Customer" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO customer (name, password) VALUES (#{name}, #{password})
    </insert>

</mapper>